---
import Loader from '../components/Loader.astro';
import Nav from '../components/Nav.astro';
import LogoCTA from '../components/LogoCTA.astro';
import HeroTitle from '../components/HeroTitle.astro';
import ScrollIndicator from '../components/ScrollIndicator.astro';
---

<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <title>Just Ballin</title>
    <link href="https://fonts.googleapis.com/css2?family=Agdasima:wght@400;700&family=Bebas+Neue&family=Barlow:wght@300;400&display=swap" rel="stylesheet"/>
    <style>
      :root {
        --black: #080808;
        --white: #f5f0e8;
        --orange: #E8621A;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { background: var(--black); color: var(--white); }
    </style>
  </head>
  <body>
    <Loader />
    <section class="hero">
      <Nav />
      <ScrollIndicator />
	  <HeroTitle />
	  <LogoCTA />
    </section>
  </body>
</html>

<style>
  .hero {
    position: relative;
    width: 100vw;
    height: 100vh;
  }
</style>